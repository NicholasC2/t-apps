{
    "name": "@t-apps/server",
    "version": "0.1.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "barrels": "barrelsby --directory src --delete",
        "build": "npm run barrels && tsc -p .",
        "clean": "rm -rf dist",
        "typecheck": "tsc -p . --noEmit"
    },
    "dependencies": {
        "@t-apps/types": "^0.1.0",
        "barrelsby": "^2.8.1",
        "express": "^5.2.1"
    },
    "devDependencies": {
        "@types/express": "^5.0.6"
    }
}
